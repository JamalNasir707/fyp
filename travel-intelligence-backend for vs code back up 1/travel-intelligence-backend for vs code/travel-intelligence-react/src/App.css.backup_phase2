.TripPrefsSection__title {
  margin: 0;
  font-size: 15px;
  font-weight: 800;
  color: #111827;
}

.TripPrefsSection__hint {
  margin: 0;
  font-size: 12px;
  line-height: 1.5;
  color: #6b7280;
}

.TripPrefGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.TripPrefGrid--questionnaire {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.TripPrefField {
  display: grid;
  gap: 7px;
  min-width: 0;
}

.TripPrefField--full {
  grid-column: 1 / -1;
}

.TripPrefField > span {
  font-size: 12px;
  font-weight: 800;
  color: #475569;
}

.TripPrefField input,
.TripPrefField select,
.TripPrefField textarea {
  width: 100%;
  min-width: 0;
  border: 1px solid rgba(203, 213, 225, 1);
  border-radius: 12px;
  padding: 11px 12px;
  font-size: 14px;
  color: #111827;
  background: #fff;
  box-sizing: border-box;
}

.TripPrefField input:focus,
.TripPrefField select:focus,
.TripPrefField textarea:focus {
  outline: none;
  border-color: rgba(59, 130, 246, 0.7);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.14);
}

.TripPrefToggleGrid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.TripPrefToggleCard {
  display: grid;
  gap: 12px;
  padding: 12px;
  border: 1px solid rgba(226, 232, 240, 1);
  border-radius: 14px;
  background: #fff;
}

.TripPrefToggleCard--full {
  grid-column: 1 / -1;
}

.TripPrefCheckbox {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 700;
  color: #111827;
}

.TripPrefCheckbox input {
  width: 16px;
  height: 16px;
  margin: 0;
}

.EngineMetaGridReact {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.EngineMetaCard {
  display: grid;
  gap: 6px;
  padding: 12px;
  border: 1px solid rgba(226, 232, 240, 1);
  border-radius: 14px;
  background: rgba(248, 250, 252, 0.95);
}

.EngineMetaCard span {
  font-size: 11px;
  font-weight: 800;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.EngineMetaCard strong {
  font-size: 15px;
  color: #111827;
  line-height: 1.25;
}

.EngineStopListReact {
  display: grid;
  gap: 10px;
}

.EngineStopRowReact {
  display: grid;
  grid-template-columns: auto auto minmax(0, 1fr);
  gap: 12px;
  align-items: flex-start;
  padding: 14px;
  border: 1px solid rgba(226, 232, 240, 1);
  border-radius: 16px;
  background: #fff;
}

.EngineStopRowReact input {
  width: 16px;
  height: 16px;
  margin-top: 4px;
}

.EngineStopRowReact__marker {
  width: 28px;
  height: 28px;
  border-radius: 999px;
  background: #3b82f6;
  color: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 800;
}

.EngineStopRowReact__content {
  display: grid;
  gap: 6px;
  min-width: 0;
}

.EngineStopRowReact__name {
  font-weight: 800;
  color: #111827;
}

.EngineStopRowReact__meta {
  font-size: 12px;
  color: #64748b;
}

.EngineIntelligenceReact {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.EngineIntelligenceReact span {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  background: rgba(220, 252, 231, 1);
  color: #166534;
  padding: 6px 9px;
  font-size: 11px;
  font-weight: 700;
}

.EngineDetailCard {
  border: 1px solid rgba(226, 232, 240, 1);
  border-radius: 16px;
  background: #fff;
  overflow: hidden;
}

.EngineDetailCard summary {
  cursor: pointer;
  list-style: none;
  padding: 14px 16px;
  font-weight: 800;
  color: #111827;
}

.EngineDetailCard summary::-webkit-details-marker {
  display: none;
}

.EngineDetailCard[open] summary {
  border-bottom: 1px solid rgba(226, 232, 240, 1);
}

.EngineDetailCard__empty {
  padding: 0 16px 16px;
  color: #6b7280;
  font-size: 13px;
}

.EnginePreviewTableWrap {
  overflow: auto;
}

.EnginePreviewTable {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.EnginePreviewTable th,
.EnginePreviewTable td {
  padding: 10px 12px;
  text-align: left;
  border-bottom: 1px solid rgba(241, 245, 249, 1);
}

.EnginePreviewTable th {
  font-size: 12px;
  font-weight: 800;
  color: #475569;
  background: rgba(248, 250, 252, 0.95);
}

.EngineTraceBlock {
  padding: 0 16px 16px;
  display: grid;
  gap: 10px;
  font-size: 13px;
  color: #334155;
}

.EngineTraceBlock__label {
  font-size: 12px;
  font-weight: 800;
  color: #475569;
}

.EngineTraceBlock pre {
  margin: 0;
  padding: 12px 14px;
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.96);
  color: rgba(255, 255, 255, 0.96);
  font-size: 12px;
  line-height: 1.45;
  overflow: auto;
  max-height: 220px;
}

.EngineSuggestionsModalReact__empty {
  padding: 32px 18px;
  border: 1px dashed rgba(203, 213, 225, 1);
  border-radius: 16px;
  text-align: center;
  color: #64748b;
  font-weight: 600;
  background: rgba(248, 250, 252, 0.86);
}

.EngineErrorBanner {
  padding: 12px 14px;
  border-radius: 14px;
  border: 1px solid rgba(254, 202, 202, 1);
  background: rgba(254, 242, 242, 1);
  color: #991b1b;
  font-size: 13px;
  font-weight: 700;
}

@media (max-width: 860px) {
  .EngineMetaGridReact,
  .TripPrefToggleGrid,
  .TripPrefGrid,
  .TripPrefGrid--questionnaire {
    grid-template-columns: 1fr;
  }

  .TripPrefsModalReact,
  .EngineSuggestionsModalReact {
    max-height: min(90vh, 920px);
  }

  .EngineSuggestionsModalReact__footer,
  .TripPrefsModalReact__footer {
    justify-content: stretch;
  }

  .EngineSuggestionsModalReact__footer .PlannerPillButton,
  .TripPrefsModalReact__footer .PlannerPillButton {
    width: 100%;
    justify-content: center;
  }
}

.ArrangementModal {
  width: min(980px, 100%);
}

.ArrangementModal__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.ArrangementModal__body {
  display: grid;
  grid-template-columns: 320px 1fr;
  gap: 14px;
  margin-top: 14px;
}

.ArrangementModal__list {
  display: grid;
  gap: 8px;
  max-height: 520px;
  overflow: auto;
  border: 1px solid rgba(226, 232, 240, 1);
  border-radius: 14px;
  padding: 10px;
}

.ArrangementModalRow {
  appearance: none;
  border: 1px solid rgba(226, 232, 240, 1);
  background: #fff;
  border-radius: 12px;
  padding: 10px 10px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 10px;
  text-align: left;
}

.ArrangementModalRow.is-active {
  border-color: rgba(59, 130, 246, 0.65);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}

.ArrangementModalRow__handle {
  color: #94a3b8;
  font-weight: 700;
}

.ArrangementModalRow__text {
  flex: 1 1 auto;
  min-width: 0;
  display: grid;
  gap: 2px;
}

.ArrangementModalRow__name {
  font-weight: 700;
}

.ArrangementModalRow__group {
  font-size: 12px;
  color: #64748b;
}

.ArrangementModalRow__meta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.ArrangementModalRow__dot {
  width: 12px;
  height: 12px;
  border-radius: 999px;
}

.ArrangementModal__editor {
  border: 1px solid rgba(226, 232, 240, 1);
  border-radius: 14px;
  padding: 12px;
  background: rgba(248, 250, 252, 0.9);
}

.ArrangementModal__editorHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.ArrangementModal__editorTitle {
  font-weight: 700;
}

.ArrangementModal__editorMeta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #64748b;
  font-size: 13px;
  margin-top: 6px;
}

.ArrangementModal__moveButtons {
  display: inline-flex;
  gap: 8px;
  flex-wrap: wrap;
}

.ArrangementModal__picker {
  margin-top: 14px;
}

.ArrangementModal__label {
  font-weight: 700;
  margin-bottom: 8px;
  color: #0f172a;
}

.ArrangementModal__colors {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.ArrangementModalColor {
  appearance: none;
  border: 1px solid rgba(226, 232, 240, 1);
  width: 34px;
  height: 34px;
  border-radius: 10px;
  cursor: pointer;
  color: #fff;
  font-weight: 700;
}

.ArrangementModalColor.is-selected {
  outline: 3px solid rgba(59, 130, 246, 0.25);
}

.ArrangementModal__icons {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.ArrangementModalIcon {
  appearance: none;
  border: 1px solid rgba(226, 232, 240, 1);
  background: #fff;
  border-radius: 12px;
  padding: 10px 12px;
  cursor: pointer;
  font-size: 16px;
}

.ArrangementModalIcon.is-selected {
  border-color: rgba(59, 130, 246, 0.65);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}

.PrintPage {
  margin: 0;
  min-height: 100vh;
  background: #e8eaed;
  color: #111827;
  font-family: Georgia, 'Times New Roman', serif;
}

.PrintToolbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 20px;
  background: #fff;
  border-bottom: 1px solid #d1d5db;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.PrintToolbar__back {
  color: #374151;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
}

.PrintToolbar__btn {
  padding: 10px 18px;
  border: 0;
  border-radius: 8px;
  background: #ff5a5f;
  color: #fff;
  font-weight: 700;
  cursor: pointer;
  font-size: 14px;
}

.PrintRoot {
  max-width: 820px;
  margin: 24px auto 48px;
  padding: 0 16px;
}

.PrintDoc {
  background: #fff;
  padding: 40px 48px 56px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  border-radius: 4px;
}

.PrintHero h1 {
  margin: 0 0 8px;
  font-size: 32px;
  font-weight: 700;
  line-height: 1.2;
}

.PrintHero p {
  margin: 0;
  font-size: 15px;
  color: #4b5563;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.PrintEmpty {
  color: #6b7280;
  font-style: italic;
  font-size: 14px;
}

.PrintDay {
  margin-top: 36px;
  margin-bottom: 28px;
  page-break-inside: avoid;
}

.PrintDay__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.PrintDay__header h3 {
  margin: 0;
  font-size: 18px;
}

.PrintTimeline {
  border-left: 2px dotted #d1d5db;
  margin-left: 14px;
  padding-left: 20px;
}

.PrintStop {
  margin-bottom: 18px;
}

.PrintStop__row {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.PrintStop__marker {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: #0d9488;
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

.PrintStop__body h4 {
  margin: 0 0 4px;
  font-size: 16px;
}

.PrintStop__body p {
  margin: 0;
  font-size: 13px;
  color: #374151;
  line-height: 1.5;
}

@media (max-width: 980px) {
  .PlannerTopbar {
    padding: 10px 14px;
    align-items: flex-start;
  }

  .PlannerTopbar__actions {
    justify-content: flex-start;
  }

  .PlannerShell {
    grid-template-columns: 1fr;
    min-height: auto;
  }

  .PlannerSidebar {
    position: static;
    height: auto;
    overflow: visible;
    border-right: 0;
    border-bottom: 1px solid rgba(226, 232, 240, 1);
    padding: 12px 14px;
  }

  .PlannerSidebar__nav {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .PlannerExploreGrid {
    grid-template-columns: 1fr;
  }

  .PlannerMainReact {
    height: auto;
    overflow: visible;
    padding: 14px;
  }

  .PlannerMainReact > .PlannerSectionCard {
    width: 100%;
  }

  .PlannerMapPanel--react {
    height: auto;
    overflow: visible;
    border-left: 0;
  }

  .PlannerMapPanel__sticky {
    position: static;
    height: 520px;
  }

  .PlannerPanelDivider {
    display: none;
  }

  .PlannerSectionCard__header {
    flex-direction: column;
    align-items: flex-start;
  }

  .OverviewGrid {
    grid-template-columns: 1fr 1fr;
  }

  .PlaceDetailsGrid {
    grid-template-columns: 1fr;
  }

  .PlannerExpenseCard {
    flex-direction: column;
  }

  .TripJournalRowReact {
    flex-direction: column;
  }

  .ArrangementModal__body {
    grid-template-columns: 1fr;
  }

  .PrintToolbar {
    padding: 12px 16px;
  }

  .PrintRoot {
    margin: 16px auto 24px;
    padding: 0 12px;
  }

  .PrintDoc {
    padding: 24px 20px 28px;
  }
}

@media print {
  .no-print {
    display: none !important;
  }

  .PrintPage {
    background: #fff;
  }

  .PrintRoot {
    margin: 0;
    max-width: none;
    padding: 0;
  }

  .PrintDoc {
    box-shadow: none;
    padding: 0;
    border-radius: 0;
  }
}
