# TripNest Mobile Environment Configuration
# Copy this file to .env for local development

# API Base URL (for ISOLATED_DEV mode with local backend)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Environment Mode: 'MOCK' (offline mock data) or 'ISOLATED_DEV' (local backend)
EXPO_PUBLIC_ENV=MOCK

# Optional CartoDB Map Tile Key (for Voyager/Positron raster basemaps)
# If left empty, the app automatically uses OpenStreetMap tiles with no API key required.
EXPO_PUBLIC_CARTO_KEY=

# Optional Google Maps Android API Key (only needed if building native android app using react-native-maps)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
